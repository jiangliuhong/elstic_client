{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "elastic-client",
  "version": "0.1.0",
  "identifier": "com.jarome.elastic.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "elastic-client",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["elastic-client"]
      }
    },
    "oauth": {
      "redirectUrl": "http://localhost:1420/callback"
    },
    "opener": {}
  }
}